####### Compile

Boggle.o: ../../src/Boggle.cpp ../../src/Boggle.h \
		../../lib/StanfordCPPLib/random.h \
		../../src/shuffle.h \
		../../lib/StanfordCPPLib/grid.h \
		../../lib/StanfordCPPLib/strlib.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o Boggle.o ../../src/Boggle.cpp

