		../../lib/StanfordCPPLib/strlib.h \
		../../src/Boggle.h \
		../../src/bogglemain.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o bogglemain.o ../../src/bogglemain.cpp

