	@test -d $(DISTDIR) || mkdir -p $(DISTDIR)
	$(COPY_FILE) --parents $(DIST) $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/Boggle.h ../../src/bogglemain.h ../../src/shuffle.h ../../lib/StanfordCPPLib/error.h ../../lib/StanfordCPPLib/foreach.h ../../lib/StanfordCPPLib/grid.h ../../lib/StanfordCPPLib/lexicon.h ../../lib/StanfordCPPLib/map.h ../../lib/StanfordCPPLib/random.h ../../lib/StanfordCPPLib/set.h ../../lib/StanfordCPPLib/simpio.h ../../lib/StanfordCPPLib/stack.h ../../lib/StanfordCPPLib/strlib.h ../../lib/StanfordCPPLib/vector.h $(DISTDIR)/
	$(COPY_FILE) --parents ../../src/Boggle.cpp ../../src/bogglemain.cpp ../../src/boggleplay.cpp ../../lib/StanfordCPPLib/error.cpp ../../lib/StanfordCPPLib/lexicon.cpp ../../lib/StanfordCPPLib/random.cpp ../../lib/StanfordCPPLib/simpio.cpp ../../lib/StanfordCPPLib/strlib.cpp $(DISTDIR)/


