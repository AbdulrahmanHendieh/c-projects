	@$(DEL_FILE) Boggle.app/Contents/PkgInfo
	@echo "APPL????" > Boggle.app/Contents/PkgInfo
Boggle.app/Contents/Info.plist: 
	@test -d Boggle.app/Contents || mkdir -p Boggle.app/Contents
	@$(DEL_FILE) Boggle.app/Contents/Info.plist
	@plutil -convert xml1 -o - /Users/abdulrahmanhendieh/Qt/6.5.3/macos/mkspecs/macx-clang/Info.plist.app | sed -e "s,@SHORT_VERSION@,1.0,g" -e "s,\$${QMAKE_SHORT_VERSION},1.0,g" -e "s,@FULL_VERSION@,1.0.0,g" -e "s,\$${QMAKE_FULL_VERSION},1.0.0,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" -e "s,@BUNDLEIDENTIFIER@,com.Abdulrahman.Boggle,g" -e "s,\$${PRODUCT_BUNDLE_IDENTIFIER},com.Abdulrahman.Boggle,g" -e "s,\$${MACOSX_DEPLOYMENT_TARGET},11.0,g" -e "s,\$${IPHONEOS_DEPLOYMENT_TARGET},,g" -e "s,\$${TVOS_DEPLOYMENT_TARGET},,g" -e "s,\$${WATCHOS_DEPLOYMENT_TARGET},,g" -e "s,\$${IOS_LAUNCH_SCREEN},LaunchScreen,g" -e "s,@ICON@,,g" -e "s,\$${ASSETCATALOG_COMPILER_APPICON_NAME},,g" -e "s,@EXECUTABLE@,Boggle,g" -e "s,@LIBRARY@,Boggle,g" -e "s,\$${EXECUTABLE_NAME},Boggle,g" -e "s,@TYPEINFO@,????,g" -e "s,\$${QMAKE_PKGINFO_TYPEINFO},????,g" >Boggle.app/Contents/Info.plist

